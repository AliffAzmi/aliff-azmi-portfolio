/* Write your global styles here, in PostCSS syntax */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-slate-50 text-slate-900 antialiased dark:bg-[#101415] dark:text-slate-100;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  h1,
  h2,
  h3,
  h4 {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    @apply font-semibold tracking-tight;
  }
}

@layer components {
  .cta-primary {
    @apply inline-flex items-center justify-center rounded-md bg-teal-600 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-700;
  }
  .cta-secondary {
    @apply inline-flex items-center justify-center rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold hover:border-slate-900 dark:border-slate-700 dark:hover:border-white;
  }
}
